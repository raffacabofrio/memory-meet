# ── Transcription backend ─────────────────────────────────────────────────────
# whisperx (default): 100% local, free, needs Python 3.12 + HF token (see README)
# openai: cloud API, needs OPENAI_API_KEY, costs per minute
TRANSCRIBER=whisperx

# ── Speaker labels in the transcript ──────────────────────────────────────────
# Your name (mic channel) and the other side (system audio channel)
MEMORYMEET_SPEAKER=Me
MEMORYMEET_INTERLOCUTOR=Interlocutor

# ── whisperx (local) ──────────────────────────────────────────────────────────
HF_TOKEN=hf_...
WHISPERX_MODEL=small          # tiny|base|small|medium|large-v2 — bigger = slower on CPU, more accurate
WHISPERX_COMPUTE_TYPE=int8    # int8 is the CPU-friendly choice
WHISPERX_LANGUAGE=pt

# Parallel transcription workers. Keep 1 on CPU (the engine already parallelizes
# internally and the model is not thread-safe) — only raise with a GPU or one
# model per worker.
MEMORYMEET_WORKERS=1

# ── openai (cloud) ────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
