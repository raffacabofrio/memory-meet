OPENAI_API_KEY=sk-...
TRANSCRIBER=openai

# Só usados quando TRANSCRIBER=whisperx (ver requirements-whisperx.txt):
HF_TOKEN=hf_...
WHISPERX_MODEL=small
WHISPERX_COMPUTE_TYPE=int8
WHISPERX_LANGUAGE=pt

# Workers de transcrição em paralelo. Manter 1 em CPU (o motor já paraleliza por
# dentro e o modelo não é thread-safe) — só subir com GPU ou um modelo por worker.
MEMORYMEET_WORKERS=1
